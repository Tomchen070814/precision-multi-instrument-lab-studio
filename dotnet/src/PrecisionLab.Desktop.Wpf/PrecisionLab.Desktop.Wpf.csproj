<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- ScottPlot.WPF 5.1.59 currently restores its WPF view assembly from
         the compatible .NET Framework asset group. Keep this exception local
         instead of weakening warnings-as-errors for the full solution. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="ScottPlot.WPF" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PrecisionLab.Contracts/PrecisionLab.Contracts.csproj" />
    <ProjectReference Include="../PrecisionLab.Domain/PrecisionLab.Domain.csproj" />
    <ProjectReference Include="../PrecisionLab.Analysis/PrecisionLab.Analysis.csproj" />
    <ProjectReference Include="../PrecisionLab.Export/PrecisionLab.Export.csproj" />
  </ItemGroup>
</Project>
